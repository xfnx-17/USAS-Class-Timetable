{
  "name": "timetable-usas",
  "private": true,
  "version": "1.0.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cf": "npm run build && npx wrangler pages dev dist",
    "build": "vite build",
    "size": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "preview:cf": "npm run build && npx wrangler pages dev dist",
    "deploy:cf": "npm run build && npx wrangler pages deploy dist",
    "lint": "eslint .",
    "lint:repo": "eslint .",
    "lint:security": "eslint -c eslint.security.config.js src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:strict": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run size",
    "test:e2e": "playwright test --reporter=line",
    "test:all": "npm run test:strict && npm run test:e2e"
  },
  "dependencies": {
    "@sentry/react": "^11.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lenis": "^1.3.25",
    "lucide-react": "^0.344.0",
    "lz-string": "^1.5.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.18",
    "eslint": "^10.8.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.8.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
